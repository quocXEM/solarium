; Solarium — international studio build

config_version=5

[application]

config/name="Solarium"
config/description="Drop light into glass. Merge until it sings. One more drop."
config/version="0.2.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Loc="*res://scripts/core/loc.gd"
SaveData="*res://scripts/core/save_data.gd"
Settings="*res://scripts/core/settings.gd"
AudioBus="*res://scripts/game/audio_bus.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
AppTheme="*res://assets/ui/theme.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

2d/default_gravity=980.0

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.07, 1)
